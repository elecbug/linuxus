# Linuxus default configuration, embedded in linuxusctl at build time.
# Generate a deployment .env with: linuxusctl init
# Relative host paths are resolved from the directory containing linuxusctl.
# Values are literal: no shell execution or environment-variable expansion.
# Change both session secrets before exposing a new deployment.

# User Service
USER_SERVICE_CONTAINER_NAME_PREFIX='linuxus_user_'
USER_SERVICE_CONTAINER_NETWORK_NAME_PREFIX='linuxus_user_net_'
USER_SERVICE_CONTAINER_BASE_SUBNET_16='10.10.0.0'
USER_SERVICE_RUNTIME_UID=1000
USER_SERVICE_RUNTIME_GID=1000
USER_SERVICE_RUNTIME_LINUX_USERNAME='user'
USER_SERVICE_RUNTIME_LINUX_HOSTNAME='linuxus'
USER_SERVICE_RUNTIME_TIMEZONE='Asia/Seoul'
USER_SERVICE_LIMITS_USER_CPU=1.5
USER_SERVICE_LIMITS_USER_MEMORY='512M'
USER_SERVICE_LIMITS_USER_PID=128
USER_SERVICE_LIMITS_USER_ULIMITS_NOFILE_SOFT=1024
USER_SERVICE_LIMITS_USER_ULIMITS_NOFILE_HARD=2048
USER_SERVICE_LIMITS_USER_DISK='512M'
USER_SERVICE_LIMITS_ADMIN_CPU=1.5
USER_SERVICE_LIMITS_ADMIN_MEMORY='512M'
USER_SERVICE_LIMITS_ADMIN_PID=128
USER_SERVICE_LIMITS_ADMIN_ULIMITS_NOFILE_SOFT=1024
USER_SERVICE_LIMITS_ADMIN_ULIMITS_NOFILE_HARD=2048
USER_SERVICE_LIMITS_ADMIN_DISK='512M'

# Auth Service
AUTH_SERVICE_CONTAINER_NAME='linuxus_auth'
AUTH_SERVICE_CONTAINER_EXTERNAL_PORT=8080
AUTH_SERVICE_RUNTIME_TIMEZONE='Asia/Seoul'
AUTH_SERVICE_SERVICE_URL_LOGIN='login'
AUTH_SERVICE_SERVICE_URL_LOGOUT='logout'
AUTH_SERVICE_SERVICE_URL_SERVICE='service'
AUTH_SERVICE_SERVICE_URL_TERMINAL='terminal'
AUTH_SERVICE_SERVICE_URL_SIGNUP='signup'
AUTH_SERVICE_MOUNTS_HOST_AUTH_LIST_PATH='data/AUTH_LIST'
AUTH_SERVICE_MOUNTS_CONTAINER_AUTH_LIST_PATH='/data/AUTH_LIST'
AUTH_SERVICE_SECURITY_SESSION_SECRET='change-this-secret-before-production'
AUTH_SERVICE_SECURITY_TRUSTED_PROXIES=''
AUTH_SERVICE_ALLOW_SIGNUP=true

# Manager Service
MANAGER_SERVICE_CONTAINER_NAME='linuxus_manager'
MANAGER_SERVICE_CONTAINER_NETWORK='linuxus_manager_net'
MANAGER_SERVICE_CONTAINER_SUBNET='10.11.0.0/24'
MANAGER_SERVICE_CONTAINER_HOMES_DIR='/vol/homes'
MANAGER_SERVICE_CONTAINER_SHARE_DIR='/vol/share'
MANAGER_SERVICE_CONTAINER_READONLY_DIR='/vol/readonly'
MANAGER_SERVICE_USER_MANAGEMENT_CLEANUP_TIMEOUT='5m'
MANAGER_SERVICE_AUTH_SERVICE_CONNECTION_TIMEOUT='30s'
MANAGER_SERVICE_SECURITY_SESSION_SECRET='change-this-secret-before-production'
MANAGER_SERVICE_ADMIN_ID='alpha'

# Volumes
VOLUMES_AUTO_ENSURE=true
VOLUMES_HOST_VOLUMES='volumes'
VOLUMES_HOST_HOMES='volumes/homes'
VOLUMES_HOST_SHARE='volumes/share'
VOLUMES_HOST_READONLY='volumes/readonly'
VOLUMES_CONTAINER_SHARE='/home/share'
VOLUMES_CONTAINER_READONLY='/home/readonly'
VOLUMES_DISK_LIMIT='1G'
